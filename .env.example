# 이 파일을 복사해서 .env 로 저장하고 값을 채우세요. (.env 는 git에 올라가지 않아요)

# 유튜브 인기 영상 가져오기 — Google Cloud Console > API 및 서비스 > 사용자 인증 정보
YOUTUBE_API_KEY=

# 영상을 연령대별로 분류하는 AI — https://platform.claude.com > API Keys
ANTHROPIC_API_KEY=

# 연령대 분류 (Jev / TypeSafe) — https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
